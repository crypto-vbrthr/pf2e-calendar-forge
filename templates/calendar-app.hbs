<div class="cf-shell">
  <header class="cf-topbar">
    <div class="cf-current-block">
      <div class="cf-eyebrow">{{calendarLabel}} · {{regionLabel}}</div>
      <div class="cf-current-date">{{current.formatted.dateTime}}</div>
      <div class="cf-current-meta">
        {{#if current.season}}<span><i class="fa-solid {{current.season.icon}}"></i>{{current.season.label}}</span>{{/if}}
        {{#each current.moons as |moon|}}<span><i class="fa-solid {{moon.icon}}"></i>{{moon.phaseLabel}}</span>{{/each}}
        {{#if current.astronomicalEvents.length}}<span><i class="fa-solid fa-star-and-crescent"></i>{{current.astronomicalEvents.length}} {{labels.astronomy}}</span>{{/if}}
      </div>
    </div>

    <div class="cf-top-actions">
      <label class="cf-region-select">
        <i class="fa-solid fa-location-dot"></i>
        <select>
          {{#each regions as |region|}}<option value="{{region.id}}" {{#if region.selected}}selected{{/if}}>{{region.label}}</option>{{/each}}
        </select>
      </label>
      <div class="cf-toolbar-group cf-display-tools" role="group" aria-label="{{labels.displayTools}}">
        <div class="cf-view-toggle" role="group" aria-label="{{labels.displayTools}}">
          <button type="button" class="{{#if isMonthView}}is-active{{/if}}" data-action="setViewMode" data-mode="month" data-tooltip="{{labels.monthView}}" aria-label="{{labels.monthView}}" aria-pressed="{{#if isMonthView}}true{{else}}false{{/if}}"><i class="fa-solid fa-calendar-day"></i></button>
          <button type="button" class="{{#if isYearView}}is-active{{/if}}" data-action="setViewMode" data-mode="year" data-tooltip="{{labels.yearView}}" aria-label="{{labels.yearView}}" aria-pressed="{{#if isYearView}}true{{else}}false{{/if}}"><i class="fa-solid fa-calendar"></i></button>
        </div>
        <button type="button" class="cf-icon-button cf-alternate-toggle {{#if showAlternateNames}}is-active{{/if}}" data-action="toggleAlternateNames" data-tooltip="{{labels.alternateNamesTooltip}}" aria-label="{{labels.alternateNamesTooltip}}" aria-pressed="{{#if showAlternateNames}}true{{else}}false{{/if}}">
          <i class="fa-solid fa-language"></i><span>{{labels.alternateNamesShort}}</span>{{#if showAlternateNames}}<i class="fa-solid fa-check cf-toggle-check" aria-hidden="true"></i>{{/if}}
        </button>
      </div>
      <div class="cf-toolbar-group cf-content-tools">
        <button type="button" class="cf-icon-button" data-action="openChronicle" data-tooltip="{{labels.chronicle}}" aria-label="{{labels.chronicle}}"><i class="fa-solid fa-book-open"></i></button>
        {{#if isGM}}
          <span class="cf-toolbar-separator" aria-hidden="true"></span>
          <button type="button" class="cf-icon-button" data-action="manageCalendars" data-tooltip="{{labels.calendars}}" aria-label="{{labels.calendars}}"><i class="fa-solid fa-calendar-days"></i></button>
          <button type="button" class="cf-icon-button" data-action="manageRegions" data-tooltip="{{labels.regions}}" aria-label="{{labels.regions}}"><i class="fa-solid fa-map-location-dot"></i></button>
          <button type="button" class="cf-icon-button" data-action="manageTemporalProfiles" data-tooltip="{{labels.temporalProfiles}}" aria-label="{{labels.temporalProfiles}}"><i class="fa-solid fa-moon"></i></button>
          <button type="button" class="cf-icon-button" data-action="manageProviders" data-tooltip="{{labels.providers}}" aria-label="{{labels.providers}}"><i class="fa-solid fa-puzzle-piece"></i></button>
        {{/if}}
      </div>
      <div class="cf-nav">
        <button type="button" data-action="previousMonth" data-tooltip="{{labels.previousMonth}}" aria-label="{{labels.previousMonth}}"><i class="fa-solid fa-chevron-left"></i></button>
        <button type="button" class="cf-today" data-action="today">{{labels.today}}</button>
        <button type="button" data-action="nextMonth" data-tooltip="{{labels.nextMonth}}" aria-label="{{labels.nextMonth}}"><i class="fa-solid fa-chevron-right"></i></button>
      </div>
    </div>
  </header>

  <main class="cf-main">
    <section class="cf-calendar-panel {{#if isYearView}}is-year-view{{/if}}">
      {{#if isMonthView}}
        <div class="cf-month-title">
          <span>{{monthLabel}}{{#if monthAlternateLabel}} <small>({{monthAlternateLabel}})</small>{{/if}}</span>
          <strong>{{viewYear}}</strong>
        </div>
      {{else}}
        <div class="cf-month-title cf-year-title"><span>{{labels.yearView}}</span><strong>{{viewYear}}</strong></div>
      {{/if}}

      <div class="cf-jump-bar">
        <div class="cf-jump-controls">
          <label><span>{{localize "CALENDAR_FORGE.Fields.Year"}}</span><input type="number" name="jump.year" value="{{viewYear}}"></label>
          <label><span>{{localize "CALENDAR_FORGE.Fields.Month"}}</span><select name="jump.monthIndex">{{#each jumpMonthOptions as |month|}}<option value="{{month.index}}" {{#if month.selected}}selected{{/if}}>{{month.label}}{{#if month.alternateLabel}} ({{month.alternateLabel}}){{/if}}</option>{{/each}}</select></label>
          <label><span>{{localize "CALENDAR_FORGE.Fields.Day"}}</span><input type="number" min="1" name="jump.day" value="{{jumpDay}}"></label>
          <button type="button" data-action="jumpToDate" data-tooltip="{{labels.jump}}"><i class="fa-solid fa-location-crosshairs"></i> {{labels.jump}}</button>
        </div>
      </div>

      {{#if isMonthView}}
        <div class="cf-weekdays" style="--cf-week-length: {{weekLength}};">
          {{#each weekdays as |weekday|}}<div><span>{{weekday.label}}</span>{{#if weekday.alternateLabel}}<small>{{weekday.alternateLabel}}</small>{{/if}}</div>{{/each}}
        </div>
        <div class="cf-month-grid" style="--cf-week-length: {{weekLength}};">
          {{#each cells as |cell|}}
            {{#if cell.empty}}
              <div class="cf-day cf-empty" data-key="{{cell.key}}"></div>
            {{else}}
              <button type="button" class="cf-day {{#if cell.isToday}}is-today{{/if}} {{#if cell.isSelected}}is-selected{{/if}}" data-action="selectDay" data-world-time="{{cell.worldTime}}" data-tooltip="{{cell.markerTitle}}">
                <span class="cf-day-number">{{cell.day}}</span>
                <span class="cf-markers">
                  {{#each cell.markers as |marker|}}<i class="fa-solid {{marker.icon}} cf-marker cf-marker-{{marker.type}}"></i>{{/each}}
                  {{#if cell.extraMarkers}}<span class="cf-more">+{{cell.extraMarkers}}</span>{{/if}}
                </span>
              </button>
            {{/if}}
          {{/each}}
        </div>
      {{else}}
        <div class="cf-year-grid">
          {{#each yearMonths as |month|}}
            <section class="cf-year-month">
              <button type="button" class="cf-year-month-title" data-action="selectMonth" data-month-index="{{month.monthIndex}}">
                <strong>{{month.label}}</strong>{{#if month.alternateLabel}}<small>{{month.alternateLabel}}</small>{{/if}}
              </button>
              <div class="cf-year-mini-weekdays" style="--cf-week-length: {{../weekLength}};">
                {{#each ../weekdays as |weekday|}}<span>{{weekday.label}}</span>{{/each}}
              </div>
              <div class="cf-year-mini-grid" style="--cf-week-length: {{../weekLength}};">
                {{#each month.cells as |cell|}}
                  {{#if cell.empty}}<span class="is-empty"></span>{{else}}<span class="{{#if cell.isToday}}is-today{{/if}} {{#if cell.isSelected}}is-selected{{/if}} {{#if cell.hasMarkers}}has-markers{{/if}}" data-tooltip="{{cell.markerTitle}}">{{cell.day}}</span>{{/if}}
                {{/each}}
              </div>
            </section>
          {{/each}}
        </div>
      {{/if}}

      <div class="cf-marker-legend">
        {{#each legend as |item|}}<span><i class="fa-solid {{item.icon}} cf-marker cf-marker-{{item.type}}"></i>{{item.label}}</span>{{/each}}
      </div>
    </section>

    <aside class="cf-inspector">
      <div class="cf-inspector-date">{{selected.formattedDate}}</div>
      <div class="cf-inspector-subtitle">{{selected.weekday}}{{#if selected.weekdayAlternate}} ({{selected.weekdayAlternate}}){{/if}} · {{selected.formattedTime}}</div>
      {{#if selected.region}}<div class="cf-inspector-region"><i class="fa-solid fa-location-dot"></i> {{selected.region.label}}</div>{{/if}}

      {{#if selected.season}}
        <section class="cf-card">
          <h3><i class="fa-solid {{selected.season.icon}}"></i> {{labels.season}}</h3>
          <div class="cf-card-row"><span>{{selected.season.label}}</span><span>{{selected.season.progressLabel}}</span></div>
          <div class="cf-progress"><span style="width: {{numberFormat selected.season.progress style='percent' maximumFractionDigits=0}}"></span></div>
          <div class="cf-detail-line">{{localize "CALENDAR_FORGE.SeasonDetails.Next"}}: {{selected.season.nextSeasonLabel}} · {{selected.season.daysRemaining}} {{localize "CALENDAR_FORGE.Units.Days"}}</div>
        </section>
      {{/if}}

      <section class="cf-card">
        <h3><i class="fa-solid fa-moon"></i> {{labels.moons}}</h3>
        {{#each selected.moons as |moon|}}
          <div class="cf-moon-row">
            <i class="fa-solid {{moon.icon}}"></i>
            <div><strong>{{moon.label}}</strong><small>{{moon.phaseLabel}} · {{moon.illuminationLabel}}</small><small>{{localize "CALENDAR_FORGE.MoonDetails.Next"}}: {{moon.nextPhaseLabel}} · {{numberFormat moon.daysUntilNextPhase maximumFractionDigits=1}} {{localize "CALENDAR_FORGE.Units.Days"}}</small></div>
          </div>
        {{else}}<div class="cf-muted">{{localize "CALENDAR_FORGE.Messages.NoMoons"}}</div>{{/each}}
        {{#each selected.moonTransitions as |transition|}}
          <div class="cf-event cf-sub-event"><i class="fa-solid {{transition.icon}}"></i><span>{{transition.formattedTime}} · {{transition.label}}</span></div>
        {{/each}}
      </section>

      <section class="cf-card cf-events-card">
        <h3><i class="fa-solid fa-star-and-crescent"></i> {{labels.astronomy}}</h3>
        {{#each selected.astronomicalEvents as |event|}}<div class="cf-event"><i class="fa-solid {{event.icon}}"></i><span>{{#if event.formattedTime}}{{event.formattedTime}} · {{/if}}{{event.label}}</span></div>{{else}}<div class="cf-muted">{{labels.noAstronomy}}</div>{{/each}}
      </section>

      <section class="cf-card cf-events-card">
        <h3><i class="fa-solid fa-star"></i> {{labels.events}}</h3>
        {{#if selected.seasonChange}}<div class="cf-event"><i class="fa-solid {{selected.seasonChange.icon}}"></i><span>{{selected.seasonChange.label}}</span></div>{{/if}}
        {{#each selected.events as |event|}}
          <div class="cf-event cf-calendar-event cf-calendar-event-{{event.type}}">
            <i class="fa-solid {{event.icon}}"></i>
            <span>
              <strong>{{#if event.formattedTime}}{{event.formattedTime}} · {{/if}}{{event.label}}</strong>
              {{#if event.descriptionText}}<small>{{event.descriptionText}}</small>{{/if}}
              {{#if event.festivalProgressLabel}}<small>{{event.festivalProgressLabel}}</small>{{/if}}
            </span>
            {{#if event.journalUuid}}<button type="button" class="cf-event-link" data-action="openEventDocument" data-uuid="{{event.journalUuid}}" data-tooltip="{{../labels.openDocument}}"><i class="fa-solid fa-book"></i></button>{{/if}}
          </div>
        {{else}}{{#unless selected.seasonChange}}<div class="cf-muted">{{labels.noEvents}}</div>{{/unless}}{{/each}}
      </section>
    </aside>
  </main>

  {{#if isGM}}
    <footer class="cf-time-controls">
      <button type="button" data-action="rewindDay"><i class="fa-solid fa-backward-step"></i> 1{{localize "CALENDAR_FORGE.Units.DayShort"}}</button>
      <button type="button" data-action="rewindHour"><i class="fa-solid fa-minus"></i> 1{{localize "CALENDAR_FORGE.Units.HourShort"}}</button>
      <span class="cf-world-time"><i class="fa-solid fa-hourglass-half"></i> {{current.formatted.dateTime}}</span>
      <button type="button" data-action="advanceHour">1{{localize "CALENDAR_FORGE.Units.HourShort"}} <i class="fa-solid fa-plus"></i></button>
      <button type="button" data-action="advanceDay">1{{localize "CALENDAR_FORGE.Units.DayShort"}} <i class="fa-solid fa-forward-step"></i></button>
    </footer>
  {{/if}}
</div>
