<div class="cf-manager-shell">
  <aside class="cf-manager-list">
    <div class="cf-manager-list-header">
      <strong>{{localize "CALENDAR_FORGE.CalendarManager.Calendars"}}</strong>
      <button type="button" data-action="newCalendar" data-tooltip="{{localize 'CALENDAR_FORGE.CalendarManager.New'}}"><i class="fa-solid fa-plus"></i></button>
    </div>
    <div class="cf-manager-items">
      {{#each calendars as |calendar|}}
        <button type="button" class="cf-manager-item {{#if calendar.isSelected}}is-selected{{/if}}" data-action="selectCalendar" data-calendar-id="{{calendar.id}}">
          <span><strong>{{calendar.label}}</strong><small>{{calendar.providerId}}</small></span>
          <span class="cf-manager-badges">
            {{#if calendar.isActive}}<i class="fa-solid fa-check" data-tooltip="{{localize 'CALENDAR_FORGE.CalendarManager.Active'}}"></i>{{/if}}
            {{#if calendar.isWorld}}<i class="fa-solid fa-pen" data-tooltip="{{localize 'CALENDAR_FORGE.CalendarManager.Editable'}}"></i>{{else}}<i class="fa-solid fa-box" data-tooltip="{{localize 'CALENDAR_FORGE.CalendarManager.Provider'}}"></i>{{/if}}
          </span>
        </button>
      {{/each}}
    </div>
  </aside>

  <main class="cf-manager-editor">
    {{#if hasSelection}}
      <header class="cf-manager-toolbar">
        <div>
          <div class="cf-eyebrow">{{providerId}}</div>
          <strong>{{definition.label.value}}</strong>
        </div>
        <div class="cf-manager-actions">
          {{#unless isActive}}<button type="button" data-action="setActiveCalendar"><i class="fa-solid fa-circle-check"></i> {{localize "CALENDAR_FORGE.CalendarManager.SetActive"}}</button>{{/unless}}
          <button type="button" data-action="duplicateCalendar"><i class="fa-solid fa-copy"></i> {{localize "CALENDAR_FORGE.CalendarManager.Duplicate"}}</button>
          {{#if editable}}<button type="button" class="cf-primary" data-action="saveCalendar"><i class="fa-solid fa-floppy-disk"></i> {{localize "CALENDAR_FORGE.CalendarManager.Save"}}</button>{{else}}<button type="button" class="cf-primary" data-action="saveCalendar"><i class="fa-solid fa-anchor"></i> {{localize "CALENDAR_FORGE.CalendarManager.SaveAnchor"}}</button>{{/if}}
          {{#if editable}}{{#unless isNew}}<button type="button" class="cf-danger" data-action="deleteCalendar"><i class="fa-solid fa-trash"></i></button>{{/unless}}{{/if}}
        </div>
      </header>

      <div class="cf-manager-scroll">
        <section class="cf-manager-section">
          <h3>{{localize "CALENDAR_FORGE.CalendarManager.Basics"}}</h3>
          <div class="cf-form-grid three">
            <label><span>{{localize "CALENDAR_FORGE.Fields.Id"}}</span><input name="calendar.id" value="{{definition.id}}" {{#unless isNew}}disabled{{/unless}}></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Name"}}</span><input name="calendar.label" value="{{definition.label.value}}" {{#unless editable}}disabled{{/unless}}></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Era"}}</span><input name="calendar.era" value="{{definition.era.value}}" {{#unless editable}}disabled{{/unless}}></label>
          </div>
          <label class="cf-full"><span>{{localize "CALENDAR_FORGE.Fields.Description"}}</span><textarea name="calendar.description" rows="2" {{#unless editable}}disabled{{/unless}}>{{definition.description.value}}</textarea></label>
        </section>

        <section class="cf-manager-section">
          <h3>{{localize "CALENDAR_FORGE.CalendarManager.TimeStructure"}}</h3>
          <div class="cf-form-grid three">
            <label><span>{{localize "CALENDAR_FORGE.Fields.SecondsPerMinute"}}</span><input type="number" min="1" name="time.secondsPerMinute" value="{{definition.time.secondsPerMinute}}" {{#unless editable}}disabled{{/unless}}></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.MinutesPerHour"}}</span><input type="number" min="1" name="time.minutesPerHour" value="{{definition.time.minutesPerHour}}" {{#unless editable}}disabled{{/unless}}></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.HoursPerDay"}}</span><input type="number" min="1" name="time.hoursPerDay" value="{{definition.time.hoursPerDay}}" {{#unless editable}}disabled{{/unless}}></label>
          </div>
        </section>

        <section class="cf-manager-section">
          <div class="cf-section-heading">
            <h3>{{localize "CALENDAR_FORGE.CalendarManager.Weekdays"}}</h3>
            {{#if editable}}<button type="button" data-action="addWeekday"><i class="fa-solid fa-plus"></i> {{localize "CALENDAR_FORGE.CalendarManager.AddWeekday"}}</button>{{/if}}
          </div>
          <div class="cf-row-table cf-weekday-table">
            <div class="cf-row-table-head"><span>{{localize "CALENDAR_FORGE.Fields.Id"}}</span><span>{{localize "CALENDAR_FORGE.Fields.Name"}}</span><span>{{localize "CALENDAR_FORGE.Fields.Short"}}</span><span>{{localize "CALENDAR_FORGE.Fields.AlternateName"}}</span><span>{{localize "CALENDAR_FORGE.Fields.AlternateShort"}}</span><span></span></div>
            {{#each definition.week.days as |day index|}}
              <div class="cf-row-table-row" data-weekday-row data-index="{{index}}">
                <input data-field="id" value="{{day.id}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="label" value="{{day.label.value}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="shortLabel" value="{{day.shortLabel.value}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="alternateLabel" value="{{day.alternateLabel.value}}" placeholder="{{localize 'CALENDAR_FORGE.Fields.AlternateExample'}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="alternateShortLabel" value="{{day.alternateShortLabel.value}}" {{#unless ../editable}}disabled{{/unless}}>
                {{#if ../editable}}<button type="button" data-action="removeWeekday" data-index="{{index}}"><i class="fa-solid fa-minus"></i></button>{{/if}}
              </div>
            {{/each}}
          </div>
        </section>

        <section class="cf-manager-section">
          <div class="cf-section-heading">
            <h3>{{localize "CALENDAR_FORGE.CalendarManager.Months"}}</h3>
            {{#if editable}}<button type="button" data-action="addMonth"><i class="fa-solid fa-plus"></i> {{localize "CALENDAR_FORGE.CalendarManager.AddMonth"}}</button>{{/if}}
          </div>
          <div class="cf-row-table cf-month-table">
            <div class="cf-row-table-head"><span>{{localize "CALENDAR_FORGE.Fields.Id"}}</span><span>{{localize "CALENDAR_FORGE.Fields.Name"}}</span><span>{{localize "CALENDAR_FORGE.Fields.Short"}}</span><span>{{localize "CALENDAR_FORGE.Fields.AlternateName"}}</span><span>{{localize "CALENDAR_FORGE.Fields.AlternateShort"}}</span><span>{{localize "CALENDAR_FORGE.Fields.Days"}}</span><span>{{localize "CALENDAR_FORGE.Fields.LeapDays"}}</span><span></span></div>
            {{#each definition.months as |month index|}}
              <div class="cf-row-table-row" data-month-row data-index="{{index}}">
                <input data-field="id" value="{{month.id}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="label" value="{{month.label.value}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="shortLabel" value="{{month.shortLabel.value}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="alternateLabel" value="{{month.alternateLabel.value}}" placeholder="{{localize 'CALENDAR_FORGE.Fields.AlternateExample'}}" {{#unless ../editable}}disabled{{/unless}}>
                <input data-field="alternateShortLabel" value="{{month.alternateShortLabel.value}}" {{#unless ../editable}}disabled{{/unless}}>
                <input type="number" min="1" data-field="days" value="{{month.days}}" {{#unless ../editable}}disabled{{/unless}}>
                <input type="number" min="0" data-field="leapDays" value="{{month.leapDays}}" {{#unless ../editable}}disabled{{/unless}}>
                {{#if ../editable}}<button type="button" data-action="removeMonth" data-index="{{index}}"><i class="fa-solid fa-minus"></i></button>{{/if}}
              </div>
            {{/each}}
          </div>
        </section>

        <section class="cf-manager-section">
          <h3>{{localize "CALENDAR_FORGE.CalendarManager.LeapRules"}}</h3>
          <div class="cf-form-grid three">
            <label><span>{{localize "CALENDAR_FORGE.Fields.LeapRule"}}</span><select name="leap.type" {{#unless editable}}disabled{{/unless}}>{{#each leapTypes as |type|}}<option value="{{type.id}}" {{#if type.selected}}selected{{/if}}>{{type.label}}</option>{{/each}}</select></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.LeapInterval"}}</span><input type="number" min="1" name="leap.interval" value="{{definition.leapYear.interval}}" {{#unless editable}}disabled{{/unless}}></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.LeapOffset"}}</span><input type="number" name="leap.offset" value="{{definition.leapYear.offset}}" {{#unless editable}}disabled{{/unless}}></label>
          </div>
        </section>

        <section class="cf-manager-section">
          <h3>{{localize "CALENDAR_FORGE.CalendarManager.Formats"}}</h3>
          <div class="cf-form-grid two">
            <label><span>{{localize "CALENDAR_FORGE.Fields.DateFormat"}}</span><input name="format.date" value="{{definition.dateFormats.date.value}}" {{#unless editable}}disabled{{/unless}}></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.DateTimeFormat"}}</span><input name="format.dateTime" value="{{definition.dateFormats.dateTime.value}}" {{#unless editable}}disabled{{/unless}}></label>
          </div>
          <p class="cf-help">{{localize "CALENDAR_FORGE.CalendarManager.FormatHelp"}}</p>
        </section>

        <section class="cf-manager-section cf-anchor-section">
          <h3>{{localize "CALENDAR_FORGE.CalendarManager.Anchor"}}</h3>
          <p class="cf-help">{{localize "CALENDAR_FORGE.CalendarManager.AnchorHelp"}}</p>
          <div class="cf-form-grid four">
            <label><span>{{localize "CALENDAR_FORGE.Fields.WorldTime"}}</span><input type="number" name="anchor.worldTime" value="{{anchor.worldTime}}"></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Year"}}</span><input type="number" name="anchor.year" value="{{anchor.year}}"></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Month"}}</span><select name="anchor.monthId">{{#each monthOptions as |month|}}<option value="{{month.id}}" {{#if month.selected}}selected{{/if}}>{{month.label}}</option>{{/each}}</select></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Day"}}</span><input type="number" min="1" name="anchor.day" value="{{anchor.day}}"></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Hour"}}</span><input type="number" min="0" name="anchor.hour" value="{{anchor.hour}}"></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Minute"}}</span><input type="number" min="0" name="anchor.minute" value="{{anchor.minute}}"></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Second"}}</span><input type="number" min="0" name="anchor.second" value="{{anchor.second}}"></label>
            <label><span>{{localize "CALENDAR_FORGE.Fields.Weekday"}}</span><select name="anchor.weekdayIndex">{{#each weekdayOptions as |day|}}<option value="{{day.index}}" {{#if day.selected}}selected{{/if}}>{{day.label}}</option>{{/each}}</select></label>
          </div>
        </section>
      </div>
    {{else}}
      <div class="cf-manager-empty">{{localize "CALENDAR_FORGE.CalendarManager.NoCalendars"}}</div>
    {{/if}}
  </main>
</div>
